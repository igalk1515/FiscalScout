# Copy to .env. Every value has a default; nothing here is required.

# Postgres from docker compose (host port 5433)
DATABASE_URL=postgres://scraper:scraper@localhost:5433/scraper

# Optional. Without a key the LLM tier is skipped and everything runs on rules alone.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Hard cap on LLM spend per crawl, in dollars. Past it, the crawl continues on rules alone.
LLM_MAX_USD_PER_CRAWL=0.5

# Default request identity for HTTP, robots.txt and browser rendering.
# Override the full header here; robots.txt matching uses its leading product token.
HTTP_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/156.0.0.0 Safari/537.36"

# Render tier, off by default: open pages drawn entirely by scripts in a headless browser.
# Only empty shells on the entity's own site that answered 200; never a page that refused us.
RENDER_JS=false
RENDER_MAX_PER_CRAWL=20
# A browser already on the machine ("msedge" or "chrome"), or the path to one.
BROWSER_CHANNEL=
BROWSER_EXECUTABLE=

PORT=3000
CRAWL_WORKERS=3
MIN_HOST_DELAY_MS=1000
RAW_DIR=data/raw
LOG_LEVEL=info
