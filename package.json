{
  "name": "high-value-link-scraper",
  "version": "0.1.0",
  "description": "Finds and ranks high-value links, finance contacts and documents on public-sector websites, with an API and a live crawl view.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "migrate": "tsx src/db/migrate.ts",
    "fetch-one": "tsx src/cli/fetch-one.ts",
    "analyze": "tsx src/cli/analyze.ts",
    "crawl": "tsx src/cli/crawl.ts",
    "crawl:test-sites": "tsx src/cli/crawl.ts --test-sites",
    "eval": "tsx src/cli/eval.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/swagger": "9.4.2",
    "@fastify/swagger-ui": "5.2.1",
    "cheerio": "1.0.0",
    "fastify": "5.2.1",
    "fastify-type-provider-zod": "4.0.2",
    "pg": "8.13.1",
    "pino": "9.6.0",
    "robots-parser": "3.0.1",
    "tldts": "6.1.70",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "20.17.10",
    "@types/pg": "8.11.10",
    "pino-pretty": "13.0.0",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  },
  "overrides": {
    "light-my-request": "6.6.0"
  }
}
